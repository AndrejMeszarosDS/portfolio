---
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { getTranslation } from "../i18n/index";

interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;

const t = (key: string) => getTranslation(lang, key);
---

<section id="about" class="py-32 bg-neutral-950">
  <Container>
    <SectionTitle subtitle={t('about.subtitle')} title={t('about.title')} />

    <div class="grid gap-12 lg:grid-cols-2">
      <div class="space-y-6">
        <p class="text-lg leading-relaxed text-neutral-300">
          I'm a passionate multimedia student with expertise in video production, motion graphics, and digital content creation. With a keen eye for visual storytelling, I transform creative ideas into compelling multimedia experiences.
        </p>

        <p class="text-lg leading-relaxed text-neutral-300">
          My work spans across commercial campaigns, independent films, and creative projects. I specialize in cinematography, video editing, color grading, and visual effects.
        </p>

        <p class="text-lg leading-relaxed text-neutral-300">
          When I'm not creating, you'll find me exploring new technologies, experimenting with emerging tools, and constantly pushing the boundaries of multimedia production.
        </p>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="heading-font mb-4 text-2xl font-bold">Skills</h3>
          <div class="grid grid-cols-2 gap-4">
            {["Cinematography", "Video Editing", "Color Grading", "Motion Graphics", "Visual Effects", "Animation", "Sound Design", "DaVinci Resolve", "Adobe Creative Suite", "Premiere Pro", "After Effects", "3D Modeling"].map((skill) => (
              <div class="rounded-lg border border-neutral-800 bg-neutral-900 px-4 py-3 text-center">
                {skill}
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="heading-font mb-4 text-2xl font-bold">Experience</h3>
          <div class="space-y-4">
            <div class="border-l-2 border-neutral-700 pl-4">
              <p class="font-semibold">Multimedia Student</p>
              <p class="text-sm text-neutral-500">Current</p>
            </div>
            <div class="border-l-2 border-neutral-700 pl-4">
              <p class="font-semibold">Freelance Content Creator</p>
              <p class="text-sm text-neutral-500">2024 - Present</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
