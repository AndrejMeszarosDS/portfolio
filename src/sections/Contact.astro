---
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
import { getTranslation } from "../i18n/index";

interface Props {
  lang?: string;
}

const { lang = "sk" } = Astro.props;

const t = (key: string) => getTranslation(lang, key);
---

<section id="contact" class="py-32">
  <Container>
    <SectionTitle subtitle={t('contact.subtitle')} title={t('contact.title')} />

    <div class="mx-auto max-w-2xl">
      <div class="rounded-2xl border border-neutral-800 bg-neutral-950 p-12">
        <form class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-semibold mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-white placeholder-neutral-500 transition focus:border-white focus:outline-none"
              placeholder="Your name"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold mb-2">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-white placeholder-neutral-500 transition focus:border-white focus:outline-none"
              placeholder="your.email@example.com"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold mb-2">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows={6}
              class="w-full rounded-lg border border-neutral-700 bg-neutral-900 px-4 py-3 text-white placeholder-neutral-500 transition focus:border-white focus:outline-none resize-none"
              placeholder="Tell me about your project..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-white px-6 py-3 font-semibold text-black transition hover:bg-neutral-200"
          >
            Send Message
          </button>
        </form>

        <div class="mt-12 border-t border-neutral-800 pt-12">
          <h3 class="heading-font mb-8 text-2xl font-bold">Other Ways to Connect</h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <a
              href="mailto:contact@example.com"
              class="rounded-lg border border-neutral-800 bg-neutral-900 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800"
            >
              <p class="text-sm text-neutral-500 mb-1">Email</p>
              <p class="font-semibold">contact@example.com</p>
            </a>
            <a
              href="https://instagram.com"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800"
            >
              <p class="text-sm text-neutral-500 mb-1">Instagram</p>
              <p class="font-semibold">@yourname</p>
            </a>
            <a
              href="https://linkedin.com"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800"
            >
              <p class="text-sm text-neutral-500 mb-1">LinkedIn</p>
              <p class="font-semibold">Your Name</p>
            </a>
            <a
              href="https://vimeo.com"
              target="_blank"
              class="rounded-lg border border-neutral-800 bg-neutral-900 px-6 py-4 transition hover:border-neutral-700 hover:bg-neutral-800"
            >
              <p class="text-sm text-neutral-500 mb-1">Vimeo</p>
              <p class="font-semibold">Portfolio</p>
            </a>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>
