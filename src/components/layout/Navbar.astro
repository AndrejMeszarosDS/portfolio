---
import Container from "../Container.astro";
---

<header class="fixed top-0 z-50 w-full border-b border-transparent bg-black/30 backdrop-blur-md">

    <Container>

        <div class="flex h-20 items-center justify-between">

            <a
                href="/"
                class="heading-font text-xl font-bold tracking-wide"
            >
                Martin Novák
            </a>

            <nav class="flex gap-8 text-sm">

                <a href="#work" class="transition hover:text-white text-neutral-400">
                    Work
                </a>

                <a href="#about" class="transition hover:text-white text-neutral-400">
                    About
                </a>

                <a href="#contact" class="transition hover:text-white text-neutral-400">
                    Contact
                </a>

            </nav>

        </div>

    </Container>

</header>